# AutoDeploy runtime environment
# These are runtime variables, so they can be changed without rebuilding the image.
VITE_SUPABASE_URL=https://supabase.smilekisan.com
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local docker-compose only
LEARNINCLUSIVE_HOST_PORT=18080

# Your self-hosted Supabase server should keep server-side secrets here,
# not in the LearnInclusive frontend environment.
